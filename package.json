{
  "name": "agent-crew",
  "version": "0.1.0",
  "description": "A desktop control room for a crew of Claude Code agents.",
  "author": "Alaa Tawalbeh",
  "license": "MIT",
  "homepage": "https://github.com/alaatawalbeh/agentcrew",
  "repository": {
    "type": "git",
    "url": "https://github.com/alaatawalbeh/agentcrew.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.mts",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && node engine/build/stage.mjs && electron-builder --linux",
    "icon": "node scripts/make-icon.mjs",
    "install-desktop": "node scripts/install-desktop.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --composite false && tsc -p tsconfig.web.json --noEmit --composite false",
    "test": "vitest run",
    "engine:prepare": "node engine/build/prepare.mjs",
    "engine:build": "node engine/build/build.mjs",
    "engine:check-updates": "node engine/build/check-updates.mjs",
    "engine:stage": "node engine/build/stage.mjs",
    "engine:smoke": "node engine/build/smoke.mjs",
    "test:engine": "vitest run --config vitest.engine.config.mts",
    "faces": "node scripts/extract-faces.mjs design/robot-crew-1a.svg src/renderer/src/robots/faces.ts",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zustand": "5.1.0"
  },
  "desktopName": "agent-crew.desktop"
}
